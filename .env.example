# Chelo Partnerships Workspace — Environment Configuration
NODE_ENV=production
PORT=3000
DATA_DIR=/data

# Strong secret (32+ hex bytes: openssl rand -hex 32) used to encrypt settings,
# key POPIA opt-out suppression hashes, stamp 4-eyes approvals, and chain audit logs.
SETTINGS_ENCRYPTION_KEY=

# Public HTTPS origin reachable by recipients for CTA links, .ics invites, and optional open pixel
PUBLIC_BASE_URL=https://partnerships.cheloapp.com

# Optional demo shortcuts (disabled automatically when NODE_ENV=production; require explicit DATA_DIR)
DEMO_ADMIN_ACCESS=false
DEMO_OPEN_ACCESS=false

# Optional OpenAI-compatible AI drafting & POPIA-scrubbed CSI copilot (can also be configured in Settings UI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Optional SMTP configuration (can also be configured in Settings UI)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Chelo Partnerships Team"
SMTP_FROM_EMAIL=
